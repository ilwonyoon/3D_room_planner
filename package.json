{
  "name": "pocketroom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mobile web 3D room planner (pocketroom) — Three.js + R3F + Claude AI",
  "scripts": {
    "dev": "vite",
    "api": "node scripts/api-server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "verify:bathroom-glbs": "node scripts/verify-bathroom-glbs.mjs",
    "eval": "node scripts/eval-trajectory.mjs"
  },
  "//": "bond-demo branch: asset-pipeline + blender + render scripts kept in scripts/ on disk but unwired from npm scripts. They live fully on `main` for the original mobile editor; this branch focuses on the demo and only needs dev/api/build.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "postprocessing": "^6.39.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "three": "^0.184.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fbx2gltf": "0.9.7-p1",
    "obj2gltf": "^3.2.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
